# Copy to .streamlit/secrets.toml (never commit it) — or use environment variables instead (they take precedence):
#   FORGESIGHT_SMTP_HOST, FORGESIGHT_SMTP_PORT, FORGESIGHT_SMTP_SECURITY, FORGESIGHT_SMTP_USER,
#   FORGESIGHT_SMTP_PASSWORD, FORGESIGHT_ALERT_FROM, FORGESIGHT_ALERT_TO
[email]
host = "smtp.office365.com"        # your SMTP server
port = 587
security = "starttls"              # starttls (587) | ssl (465) | none
username = "alerts@yourcompany.com"
password = "app-password-here"     # use an app password / SMTP credential, not your main login
sender = "alerts@yourcompany.com"
recipients = ["ehs-team@yourcompany.com"]
